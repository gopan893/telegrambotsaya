# ===== BUDGET & RATE LIMIT =====
# Budget token per user per hari
USER_DAILY_TOKEN_LIMIT=50000
# Maksimal pesan per jam per user
USER_HOURLY_MESSAGE_LIMIT=30

# ===== FEATURE FLAGS =====
# Portfolio manager (multi-project tracking)
ENABLE_PORTFOLIO_MANAGER=false
# Disaster recovery system
ENABLE_DISASTER_RECOVERY=false
# Autonomous loop (self-operating)
ENABLE_AUTONOMOUS_LOOP=false
# Multi-bot mode
ENABLE_MULTIBOT=false

# ===== ALERTING =====
# Kirim alert ke owner via Telegram
ALERT_ENABLED=true
# Level minimum alert: info, warning, critical
ALERT_MIN_LEVEL=warning
