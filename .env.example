TELEGRAM_BOT_TOKEN=isi_token_bot_telegram
OPENAI_API_KEY=isi_api_key_openai

# Model utama. Gunakan model terbaik yang tersedia di akun kamu.
OPENAI_MODEL=gpt-5.2
OPENAI_REASONING_EFFORT=medium
MAX_OUTPUT_TOKENS=1800

# Fitur tambahan
ENABLE_WEB_SEARCH=true
ENABLE_IMAGE_INPUT=true
AUTO_MEMORY=true

# Opsional: kalau kamu sudah punya OpenAI vector store untuk file search.
# OPENAI_VECTOR_STORE_ID=vs_xxxxxxxxxxxxxxxxx

# Admin Telegram user id, pisahkan koma jika banyak.
# ADMIN_USER_IDS=123456789,987654321

# Batas anti-spam per user.
RATE_LIMIT_MESSAGES=10
RATE_LIMIT_WINDOW_SECONDS=60

# Lokasi data lokal.
DATA_FILE=./data/state.json
KNOWLEDGE_DIR=./knowledge
