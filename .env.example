TELEGRAM_TOKEN=isi_token_bot_telegram

# Pilih provider AI: openai atau mistral
AI_PROVIDER=mistral

# Kalau pakai OpenAI
OPENAI_API_KEY=isi_api_key_openai
OPENAI_MODEL=gpt-5.2
OPENAI_REASONING_EFFORT=medium

# Kalau pakai Mistral
MISTRAL_API_KEY=isi_api_key_mistral
MISTRAL_MODEL=mistral-large-latest

MAX_OUTPUT_TOKENS=1800

# Fitur tambahan
# Web search dan vector store hanya aktif untuk provider OpenAI.
ENABLE_WEB_SEARCH=true
ENABLE_IMAGE_INPUT=true
AUTO_MEMORY=true

# Opsional: kalau kamu sudah punya OpenAI vector store untuk file search.
# OPENAI_VECTOR_STORE_ID=vs_xxxxxxxxxxxxxxxxx

# Admin Telegram user id, pisahkan koma jika banyak.
OWNER_CHAT_ID=123456789

# Batas anti-spam per user.
RATE_LIMIT_MESSAGES=10
RATE_LIMIT_WINDOW_SECONDS=60

# Lokasi data lokal.
DATA_FILE=./data/state.json
KNOWLEDGE_DIR=./knowledge
