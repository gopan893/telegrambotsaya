{
  "name": "telegram-ai-level-tertinggi",
  "version": "2.0.0",
  "description": "Autonomous Telegram AI Agent (Polymath) dengan Fallback Multi-Model, RAG, dan Notifikasi Proaktif — Stable AI OS v1 Release Candidate.",
  "main": "telebot.js",
  "scripts": {
    "start": "node telebot.js",
    "dev": "node --watch telebot.js",
    "dev:local": "node --watch start-local.js",
    "start:local": "node start-local.js",
    "check": "node --check telebot.js",
    "push": "bash scripts/push-code.sh",
    "push:msg": "bash scripts/push-code.sh",
    "check:release": "node --check src/release/index.js",
    "test:release-store": "node scratch/test-release-candidate-store.js",
    "test:release-freeze": "node scratch/test-release-freeze-manager.js",
    "test:release-readiness": "node scratch/test-module-readiness-checker.js",
    "test:release-gate": "node scratch/test-production-readiness-gate.js",
    "test:release-compat": "node scratch/test-compatibility-verifier.js",
    "test:release-risk": "node scratch/test-release-risk-reviewer.js",
    "test:release-notes": "node scratch/test-release-notes-generator.js",
    "test:release-changelog": "node scratch/test-changelog-generator.js",
    "test:release-env": "node scratch/test-environment-checklist-generator.js",
    "test:release-dashboard": "node scratch/test-release-candidate-dashboard-api.js",
    "test:release-regression": "node scratch/test-phase50-release-candidate-regression.js",
    "test:rc-auditor": "node scratch/test-rc-stabilization-auditor.js",
    "test:rc-blocker": "node scratch/test-rc-blocker-classifier.js",
    "test:rc-regression": "node scratch/test-rc-regression-checker.js",
    "test:rc-fixpolicy": "node scratch/test-rc-fix-policy.js",
    "test:rc-stabilization": "node scratch/test-phase50-5-rc-stabilization-regression.js",
    "test:rc-all": "node scratch/test-rc-stabilization-auditor.js && node scratch/test-rc-blocker-classifier.js && node scratch/test-rc-regression-checker.js && node scratch/test-rc-fix-policy.js && node scratch/test-phase50-5-rc-stabilization-regression.js",
    "test:pr-manager": "node scratch/test-production-release-manager.js",
    "test:pr-readiness": "node scratch/test-rollout-readiness-gate.js",
    "test:pr-planner": "node scratch/test-release-rollout-planner.js",
    "test:pr-github": "node scratch/test-github-release-proposal-builder.js",
    "test:pr-deploy": "node scratch/test-production-deploy-proposal-builder.js",
    "test:pr-verify": "node scratch/test-release-verification-checker.js",
    "test:slo-registry": "node scratch/test-slo-registry.js",
    "test:slo-monitor": "node scratch/test-slo-monitor.js",
    "test:pr-monitor": "node scratch/test-post-release-monitor.js",
    "test:health-window": "node scratch/test-release-health-window.js",
    "test:watchdog": "node scratch/test-regression-watchdog.js",
    "test:scorecard": "node scratch/test-reliability-scorecard.js",
    "test:51-52-regression": "node scratch/test-phase51-52-production-release-regression.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "axios": "^1.6.0",
    "express": "^4.18.2",
    "form-data": "^4.0.0",
    "googleapis": "^126.0.0",
    "ioredis": "^5.3.2",
    "node-schedule": "^2.1.1",
    "pdf-parse": "^1.1.1",
    "pg": "^8.12.0",
    "sharp": "^0.33.0",
    "ws": "^8.21.0"
  }
}
